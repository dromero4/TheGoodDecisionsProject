// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Creacion de la tabla para el JSON
model RawProducts {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
}

//Creacion de las tablas de la base de datos
model Product {
  id               Int      @id @default(autoincrement())
  externalId       String   @unique
  name             String
  createdAt        DateTime @default(now())
  shortDescription String?
  longDescription  String?
  category         String?

  images   Image[]
  variants Variant[]
}

model Price {
  id        Int @id @default(autoincrement())
  variantId Int @unique

  unit   Float
  gt10   Float?
  gt100  Float?
  gt500  Float?
  gt1000 Float?

  variant Variant @relation(fields: [variantId], references: [id])
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  size      String
  category  String?
  color     String?
  sku       String?

  stock Int @default(500)

  product Product @relation(fields: [productId], references: [id])
  prices  Price[]

  @@unique([productId, size, color, sku])
}

model Image {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  type      String?
  color     String?

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, url])
}

// ROLY
model RolyProduct {
  productId    String  @id // modelcode
  name         String // modelname
  displayName  String?
  description  String?
  family       String?
  familyCode   String?
  gender       String?
  genderCode   String?
  observations String?
  weight       Float?

  variants RolyVariant[]
  images   RolyImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolyVariant {
  variantId String  @id // itemcode
  productId String
  sku       String
  barcode   String?

  sizeCode  String?
  sizeLabel String?
  sizeValue String?

  colorCode String?
  colorName String?

  rawName String?

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorCode, sizeCode])
  @@index([productId])
  @@index([productId, colorCode])
  @@index([productId, sizeCode])
}

model RolyImage {
  id        Int     @id @default(autoincrement())
  productId String
  colorCode String?
  url       String

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorCode, url])
  @@index([productId])
  @@index([productId, colorCode])
}

model RawTopTexProducts {
  externalId String   @id
  payload    Json
  source     String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  designs      Design[]

  address UserAddress?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAddress {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String?
  phone          String?
  street         String?
  number         String?
  floorDoor      String?
  postalCode     String?
  city           String?
  province       String?
  country        String? @default("Spain")
  additionalInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String  @id @default(cuid())
  stripeSessionId String?
  customerEmail   String?
  items           Json
  shippingAddress Json?
  cartTotal       Float
  paymentStatus   String  @default("pending")
  emailSent       Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Design {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
