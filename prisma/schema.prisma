generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Creacion de la tabla para el JSON
model RawProducts {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
}

// Creacion de las tablas de la base de datos
model Product {
  id               Int      @id @default(autoincrement())
  externalId       String   @unique
  name             String
  createdAt        DateTime @default(now())
  shortDescription String?
  longDescription  String?

  images   Image[]
  variants Variant[]
}

model Price {
  id        Int @id @default(autoincrement())
  variantId Int @unique

  unit   Float
  gt10   Float?
  gt100  Float?
  gt500  Float?
  gt1000 Float?

  variant Variant @relation(fields: [variantId], references: [id])
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  size      String
  color     String?
  sku       String?

  product Product @relation(fields: [productId], references: [id])
  prices  Price[]

  @@unique([productId, size, color, sku])
}

model Image {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  type      String?
  color     String?

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, url])
}

// ROLY
model RolyProduct {
  productId   String  @id // ahora será baseProductId, ej: "BA909"
  name        String
  description String?
  weight      Float?

  variants RolyVariant[]
  images   RolyImages[] // opcional: imágenes por modelo o por color (te explico abajo)
}

model RolyVariant {
  id Int @id @default(autoincrement())

  productId      String // FK -> RolyProduct.productId (base)
  colorProductId String // ej: "BA909-01" (modelo+color)
  size           String

  color_code Int
  color_name String
  name       String?

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, colorProductId, size]) // 1 talla por color dentro del modelo
}

model RolyImages {
  id             Int    @id @default(autoincrement())
  productId      String // base (BA909)
  colorProductId String // color (BA909-01)
  url            String

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
  @@index([productId, colorProductId])
  @@unique([colorProductId, url])
}

model RawTopTexProducts {
  externalId String   @id
  payload    Json
  source     String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model FallkRossProducts {
  productId   String  @id @map("product_id")
  externalId String @unique @map("external_id")
  shortDescription String? @map("short_description")
  longDescription  String? @map("long_description")

  images   FalkRossImage[]
  variants FalkRossVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("falk_ross_products")
}

model FalkRossVariant {
  id Int @id @default(autoincrement())

  sku       String
  size      String
  color     String


  productId String @map("product_id")
  product FallkRossProducts @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, size, color, sku])

  @@map("falk_ross_variant")
}

model FalkRossImage {
  id Int @id @default(autoincrement())

  sku       String
  url       String
  color     String?

  productId String @map("product_id")
  product FallkRossProducts @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, sku, color])

  @@map("falk_ross_image")
}