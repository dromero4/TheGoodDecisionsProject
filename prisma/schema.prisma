// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Creacion de la tabla para el JSON
model RawProducts {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
}

//Creacion de las tablas de la base de datos
model Product {
  id               Int      @id @default(autoincrement())
  externalId       String   @unique
  name             String
  createdAt        DateTime @default(now())
  shortDescription String?
  longDescription  String?

  images   Image[]
  variants Variant[]
}

model Price {
  id        Int @id @default(autoincrement())
  variantId Int @unique

  unit   Float
  gt10   Float?
  gt100  Float?
  gt500  Float?
  gt1000 Float?

  variant Variant @relation(fields: [variantId], references: [id])
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  size      String
  color     String?
  sku       String?

  product Product @relation(fields: [productId], references: [id])
  prices  Price[]

  @@unique([productId, size, color, sku])
}

model Image {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  type      String?
  color     String?

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, url])
}

// ROLY
model RolyProduct {
  productId    String  @id // modelcode
  name         String // modelname
  displayName  String?
  description  String?
  family       String?
  familyCode   String?
  gender       String?
  genderCode   String?
  observations String?
  weight       Float?

  variants RolyVariant[]
  images   RolyImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolyVariant {
  variantId String  @id // itemcode
  productId String
  sku       String
  barcode   String?

  sizeCode  String?
  sizeLabel String?
  sizeValue String?

  colorCode String?
  colorName String?

  rawName String?

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorCode, sizeCode])
  @@index([productId])
  @@index([productId, colorCode])
  @@index([productId, sizeCode])
}

model RolyImage {
  id        Int     @id @default(autoincrement())
  productId String
  colorCode String?
  url       String

  product RolyProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorCode, url])
  @@index([productId])
  @@index([productId, colorCode])
}

model RawTopTexProducts {
  externalId String   @id
  payload    Json
  source     String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model FallkRossProducts {
  productId        String  @id @map("product_id")
  shortDescription String? @map("short_description")
  longDescription  String? @map("long_description")

  images   FalkRossImages[]
  variants FalkRossVariants[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("falk_ross_products")
}

model FalkRossVariants {
  sku   String @id
  size  String
  color String

  productId String            @map("product_id")
  product   FallkRossProducts @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId])
  @@index([productId, color])
  @@index([productId, size])
  @@map("falk_ross_variant")
}

model FalkRossImages {
  sku String @id
  url String

  productId String            @map("product_id")
  product   FallkRossProducts @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId])
  @@map("falk_ross_image")
}

model FalkRossPrices {
  sku          String @id
  defaultPrice Float @map("default_price")
  price        Float
  currency     String

  @@unique([sku, currency])
  @@map("falk_ross_price")
}
